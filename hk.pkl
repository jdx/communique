amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["cargo-clippy"] = (Builtins.cargo_clippy) {
        check = "cargo clippy --manifest-path {{workspace_indicator}} --quiet -- -D warnings"
    }
    ["cargo-fmt"] = Builtins.cargo_fmt
    // lints GitHub Actions workflows (jdx/jactionlint, a maintained actionlint fork)
    ["jactionlint"] {
        glob = List(
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml",
            ".github/actions/**/action.y*ml",
            ".github/dependabot.y*ml"
        )
        batch = true
        check = new CommandSpec {
            command = "jactionlint {{ files }}"
            effect = "read"
        }
        fix = new CommandSpec {
            command = "jactionlint --fix {{ files }}"
            effect = "write"
        }
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
